DATABASE_URL=postgres://operator:operator@localhost:5432/operator
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
AUTH_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local end-to-end mode: completes execution steps without touching outside systems.
OPERATOR_DEMO_MODE=true

SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_PASSWORD=replace-with-a-strong-development-password
SEED_ORG_NAME=Operator Demo
SEED_ORG_SLUG=operator-demo

# Optional reasoning planner. Without it, Operator uses the deterministic safe planner.
OPERATOR_PLANNER_URL=
OPERATOR_PLANNER_SECRET=
OPERATOR_REQUIRE_REMOTE_PLANNER=false
OPERATOR_PLANNER_ALLOW_PRIVATE_CONTEXT=false

# Browser/API execution contract
OPERATOR_ACTION_RUNNER_URL=
OPERATOR_ACTION_RUNNER_SECRET=

# Preferred conversational voice-agent contract. Twilio can be used as a basic fallback.
OPERATOR_VOICE_AGENT_URL=
OPERATOR_VOICE_AGENT_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Signed callbacks from action/voice/human providers
OPERATOR_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Human exception queue
OPERATOR_HUMAN_QUEUE_URL=
OPERATOR_HUMAN_QUEUE_SECRET=

# Email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Scheduler authentication for /api/jobs/operator-routines
CRON_SECRET=replace-with-a-long-random-secret

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ASSISTANT=
STRIPE_PRICE_OPERATOR=
STRIPE_PRICE_CONCIERGE=
